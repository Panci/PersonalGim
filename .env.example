# Public URL used by the Expo web build. In Docker/Dokploy it stays relative.
EXPO_PUBLIC_API_URL=/api

# PostgreSQL (use unique, strong values before deployment)
POSTGRES_DB=personalgim
POSTGRES_USER=personalgim
POSTGRES_PASSWORD=replace-with-a-long-random-password
# If PostgreSQL is accessed over TLS, enable certificate verification and
# provide the trusted CA PEM through DB_SSL_CA in the API environment.
# DB_SSL=true
# DB_SSL_CA=

# API security and initial administrator (never commit the real values)
JWT_SECRET=replace-with-a-long-random-jwt-secret
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PIN=replace-with-a-4-digit-pin

# Add the public app URL after assigning a domain, e.g. https://gym.example.com
CORS_ORIGIN=
APP_PORT=8080

# WhatsApp Business Cloud API (leave empty until a sender number and approved
# utility template are configured in Meta Business Manager).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=cuota_recordatorio
WHATSAPP_TEMPLATE_LANGUAGE=es_ES
WHATSAPP_GRAPH_API_VERSION=
BILLING_TIME_ZONE=Europe/Madrid
